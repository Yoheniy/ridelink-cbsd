BETTER_AUTH_SECRET=generate 32 length random string
BETTER_AUTH_URL=http://localhost:5000 

FRONTEND_URL=http://localhost:3000

DATABASE_URL=

# Resend api key for sending email
RESEND_API_KEY=

# Convex realtime backend
CONVEX_SITE_URL=                     # Your Convex deployment URL (e.g., http://localhost:3211 for local, https://your-project-123.convex.cloud for cloud)
CONVEX_INTERNAL_API_KEY=        # Shared API key for Express→Convex HTTP calls (generate a 32+ char random string)

# Note: BETTER_AUTH_URL must also be set as a Convex environment variable
# (via Convex dashboard) so Convex can fetch JWKS from Express for JWT verification.
