		"@prisma/adapter-neon": "^7.3.0",
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@types/bcrypt": "^6.0.0",
		"@types/http-errors": "^2.0.5",
		"@types/ws": "^8.18.1",
		"bcrypt": "^6.0.0",
		"better-auth": "^1.4.17",
		"convex": "^1.32.0",
		"cors": "^2.8.6",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.3",
		"express": "^5.2.1",
		"http-errors": "^2.0.1",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.10.1",
		"pg": "^8.18.0",
		"resend": "^6.9.2",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"ws": "^8.19.0",
		"zod": "^4.3.6"
