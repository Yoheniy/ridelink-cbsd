{
	"name": "ridelink-backend",
	"type": "module",
	"scripts": {
		"test": "cross-env NODE_ENV=test TEST_DATABASE_URL=$TEST_DATABASE_URL vitest run",
		"test:watch": "cross-env NODE_ENV=test TEST_DATABASE_URL=$TEST_DATABASE_URL vitest",
		"build": "tsdown",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"db:push": "prisma db push",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev && prisma generate",
		"db:studio": "prisma studio",
		"db:seed": "prisma db seed",
		"db:reset": "prisma migrate reset",
		"convex:dev": "npx convex dev --local",
		"convex:deploy": "npx convex deploy",
		"convex:codegen": "npx convex dev --local --once"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.4.3",
